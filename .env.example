# ============================================================================
# Ledger Service — Environment Configuration
# ============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Never commit .env with real credentials.
# ============================================================================

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5

# Logging
# Options: trace, debug, info, warn, error
# Per-module: ledger_service=debug,tower_http=info,sqlx=warn
RUST_LOG=ledger_service=debug,tower_http=debug,sqlx=info
